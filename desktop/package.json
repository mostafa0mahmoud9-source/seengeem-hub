{
  "name": "seengeem-assistant-desktop",
  "productName": "مساعد سين جيم",
  "version": "2.3.0",
  "description": "تطبيق متابعة منصة سين جيم على الكمبيوتر",
  "main": "main.js",
  "author": "SeenGeem",
  "scripts": {
    "start": "node scripts/make-icon.js && node scripts/copy-www.js && electron .",
    "dist": "node scripts/make-icon.js && node scripts/copy-www.js && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "@whiskeysockets/baileys": "^6.7.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.seengeem.assistant",
    "productName": "مساعد سين جيم",
    "files": [
      "main.js",
      "wa.js",
      "preload.js",
      "www/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "executableName": "SeenGeemAssistant"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SeenGeem-Assistant-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_GITHUB_USER",
        "repo": "seengeem-hub"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}